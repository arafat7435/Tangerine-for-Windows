<Window x:Class="Tangerine.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Tangerine" Style="{StaticResource {x:Type Window}}" Title="{x:Static local:App.DisplayName}" Width="1080" Height="850" MinWidth="940" MinHeight="700" WindowStartupLocation="CenterScreen" AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop">
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="196"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#FAFAF8" BorderBrush="#E1E3DF" BorderThickness="0,0,1,0">
   <DockPanel Margin="15,25,15,20">
    <StackPanel DockPanel.Dock="Top" Margin="8,0,0,28">
     <StackPanel Orientation="Horizontal"><Border Width="27" Height="27" CornerRadius="14" Background="#FF5900" Margin="0,0,9,0"><TextBlock Text="✳" Foreground="White" FontSize="22" HorizontalAlignment="Center" Margin="0,-2,0,0"/></Border><TextBlock Text="Tangerine" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
     <TextBlock Text="Native tools. Local files." FontSize="10" Foreground="#8B938B" Margin="36,7,0,0"/>
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom">
     <Button Content="⚙   Settings" Click="SettingsClick" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Margin="0,0,0,17"/>
     <Border Background="#EEF2EB" CornerRadius="8" Padding="12"><StackPanel><TextBlock Text="●  Everything stays local" Foreground="#5C7252" FontSize="11"/><TextBlock Text="Ready in your system tray" Foreground="#8A9186" FontSize="10" Margin="13,5,0,0"/></StackPanel></Border>
    </StackPanel>
    <StackPanel><TextBlock Text="YOUR FILE TOOLKIT" FontSize="9" FontWeight="SemiBold" Foreground="#9A9E98" Margin="12,0,0,11"/><ListBox x:Name="CategoryList" BorderThickness="0" Background="Transparent" SelectionChanged="CategoryChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
     <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Margin" Value="0,2"/><Setter Property="Padding" Value="12,10"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="b" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="b" Property="Background" Value="#FFE9DB"/><Setter Property="Foreground" Value="#DC4D00"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#F0F0EB"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
     <ListBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets" Width="26" VerticalAlignment="Center"/><TextBlock Text="{Binding Name}" FontSize="13"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
    </ListBox><Button Content="↗   File actions" Click="ActionsClick" Background="Transparent" BorderThickness="0" Margin="0,15,0,0"/></StackPanel>
   </DockPanel>
  </Border>
  <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel Margin="32,29,32,25">
    <Grid Margin="0,0,0,23"><StackPanel><TextBlock Text="SMALL GESTURES. MORE FLOW." FontSize="9" FontWeight="SemiBold" Foreground="#9A9E98"/><TextBlock Text="Your files, transformed." FontSize="25" FontWeight="SemiBold" Margin="0,7,0,0"/></StackPanel><Button Content="Add files  +" Style="{StaticResource Primary}" Click="BrowseClick" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
    <Border Background="White" BorderBrush="#E1E4DF" BorderThickness="1" CornerRadius="21" Padding="18,23,18,21">
     <StackPanel>
      <TextBlock x:Name="Heading" Text="Image tools" FontSize="30" HorizontalAlignment="Center" Margin="0,0,0,23"/>
      <Grid x:Name="WheelGrid">
       <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="1"/><ColumnDefinition/></Grid.ColumnDefinitions>
       <StackPanel x:Name="ConvertPanel" HorizontalAlignment="Center">
        <Border Background="#FAFBF8" BorderBrush="#D5DAD4" BorderThickness="1,1,1,5" CornerRadius="11" Width="79" Height="72" Padding="11,6" Margin="0,0,0,17"><StackPanel><TextBlock x:Name="ConvertGlyph" Text="⇧" FontSize="25" Foreground="#768174"/><TextBlock x:Name="ConvertKey" Text="shift" FontSize="10" Foreground="#697466"/></StackPanel></Border>
        <TextBlock x:Name="ConvertCaption" Text="Convert formats" HorizontalAlignment="Center" Foreground="#797F7B" Margin="0,0,0,20"/>
        <local:RadialWheel x:Name="ConvertWheel"/>
        <TextBlock x:Name="ConvertHint" Text="Convert to PNG" Foreground="#7C898E" FontSize="12" HorizontalAlignment="Center" Margin="0,6,0,0"/>
       </StackPanel>
       <Border x:Name="Divider" Grid.Column="1" Background="#E3E5E1"/>
       <StackPanel x:Name="ToolsPanel" Grid.Column="2" HorizontalAlignment="Center">
        <Border Background="#FAFBF8" BorderBrush="#D5DAD4" BorderThickness="1,1,1,5" CornerRadius="11" Width="79" Height="72" Padding="11,6" Margin="0,0,0,17"><StackPanel><TextBlock x:Name="ToolsGlyph" Text="⌃" FontSize="25" Foreground="#768174"/><TextBlock x:Name="ToolsKey" Text="ctrl" FontSize="10" Foreground="#697466"/></StackPanel></Border>
        <TextBlock Text="File tools" HorizontalAlignment="Center" Foreground="#797F7B" Margin="0,0,0,20"/>
        <local:RadialWheel x:Name="ToolsWheel"/>
        <TextBlock x:Name="ToolsHint" Text="Compress" Foreground="#7C898E" FontSize="12" HorizontalAlignment="Center" Margin="0,6,0,0"/>
       </StackPanel>
      </Grid>
      <TextBlock Text="Start dragging, then tap a key. The wheel stays open until you drop." FontSize="11" Foreground="#90958C" HorizontalAlignment="Center" Margin="0,24,0,0"/>
     </StackPanel>
    </Border>
    <Border x:Name="DropArea" Background="#EFEFEA" CornerRadius="12" BorderBrush="#DDE1D8" BorderThickness="1" Margin="0,18,0,0" Padding="18,14"><Grid><StackPanel><TextBlock x:Name="SelectedTitle" Text="Drop your files here" FontWeight="SemiBold" FontSize="13"/><TextBlock x:Name="SelectedDetail" Text="Or drag in Explorer, tap Shift, and drop onto a format." Foreground="#8B9387" FontSize="11" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/></StackPanel><Button x:Name="ClearButton" Content="Clear" Click="ClearClick" HorizontalAlignment="Right" VerticalAlignment="Center" Background="Transparent" BorderThickness="0" Visibility="Collapsed"/></Grid></Border>
    <Grid Margin="0,22,0,11"><TextBlock Text="Recent activity" FontWeight="SemiBold"/><Button Content="Cancel current job" Click="CancelClick" HorizontalAlignment="Right" Padding="8,2" Background="Transparent" BorderThickness="0" FontSize="10" Foreground="#969C91"/></Grid>
    <TextBlock x:Name="EmptyHistory" Text="Your finished files will appear here. Originals are kept." Foreground="#999F95" FontSize="11" Margin="0,0,0,10"/>
    <ItemsControl x:Name="JobList"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="#E1E5DC" BorderThickness="0,0,0,1" Padding="0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="150"/><ColumnDefinition Width="45"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Operation}" FontSize="10" Foreground="#939B8F" Margin="0,3,0,0"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding Status}" Foreground="#7A8871" VerticalAlignment="Center" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}"/><Button Content="↗" Grid.Column="2" Padding="8,5" Click="RevealClick" Tag="{Binding}" ToolTip="Show output in Explorer"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
   </StackPanel>
  </ScrollViewer>
 </Grid>
</Window>
